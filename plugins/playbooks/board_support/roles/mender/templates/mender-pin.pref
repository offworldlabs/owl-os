# Every Mender package installed at an exact version needs that version to be
# apt's CANDIDATE, not merely present in the index. The mender-* rule at the
# bottom prefers whatever is newest on Mender's server, so as soon as Mender
# publishes anything newer than a version in versions.yml, the candidate for
# that package moves ahead of the version we ask for. apt itself copes with
# that and installs the older version on request, but ansible's apt module
# refuses, reporting "no available installation candidate" for a version that
# is sitting right there in the index. The message is misleading: the version
# is unreachable, not absent.
#
# This is not hypothetical. Mender regenerated their repository on 2026-10-01
# and published newer builds of three of the four packages pinned below, which
# failed four consecutive os-v0.18.x builds, one task at a time.
#
# The rules below pin each exactly-installed package to the version in
# versions.yml, which makes requested and candidate the same by construction,
# whatever Mender publishes next. The versions come from the same variables the
# install tasks use, so versions.yml stays the only place a Mender version is
# chosen and these cannot drift from it.
#
# mender-client4 additionally depends on mender-auth and mender-update at
# exactly its own version, and only mender-client4 is named with a version when
# it is installed, so those two are pinned alongside it or they resolve forward
# and contradict it.
Package: mender-client4 mender-auth mender-update
Pin: version {{ mender_client_version }}
Pin-Priority: 1001

Package: mender-connect
Pin: version {{ mender_connect_version }}
Pin-Priority: 1001

Package: mender-docker-compose
Pin: version {{ mender_docker_compose_version }}
Pin-Priority: 1001

# Pinned even though its version is currently the newest, so it does not become
# the next package to fail the moment Mender publishes a newer one.
Package: mender-configure
Pin: version {{ mender_configure_version }}
Pin-Priority: 1001

# Debian ships its own, much older mender-client. These two rules keep Mender's
# repository winning for every mender-* package regardless.
Package: mender-*
Pin: origin downloads.mender.io
Pin-Priority: 1000

Package: mender-*
Pin: release o=Debian
Pin-Priority: 100
